{
  "name": "86-board",
  "private": true,
  "version": "0.1.0",
  "description": "Live 86 board for restaurant staff: what is out, since when, and why.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "typecheck:backend": "node scripts/env-stubs.mjs && tsc --noEmit -p amplify/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run typecheck:backend && npm test",
    "build": "tsc --noEmit && vite build && node scripts/make-artifact.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1152.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "aws-amplify": "^6.22.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.25.1",
    "@aws-amplify/backend-cli": "^1.10.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^4.7.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-singlefile": "^2.2.0",
    "vitest": "^3.2.7"
  }
}
